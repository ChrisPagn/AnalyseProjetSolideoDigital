@inject DomaineApiClient DomaineApi

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField T="string" Label="Given (étant donné)" @bind-Value="_given" Required="true"
                          RequiredError="Champ requis." Lines="2" Class="mb-3" />
            <MudTextField T="string" Label="When (quand)" @bind-Value="_when" Required="true"
                          RequiredError="Champ requis." Lines="2" Class="mb-3" />
            <MudTextField T="string" Label="Then (alors)" @bind-Value="_then" Required="true"
                          RequiredError="Champ requis." Lines="2" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Annuler">Annuler</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_enCours" OnClick="@EnregistrerAsync">
            @(_enCours ? "Enregistrement..." : "Enregistrer")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int ProjetId { get; set; }
    [Parameter] public int FonctionnaliteId { get; set; }

    private MudForm? _form;
    private string _given = string.Empty;
    private string _when = string.Empty;
    private string _then = string.Empty;
    private bool _enCours;

    private async Task EnregistrerAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _enCours = true;
        var dto = new UpsertCritereAcceptationDto(_given, _when, _then);
        var resultat = await DomaineApi.AjouterCritereAsync(ProjetId, FonctionnaliteId, dto);
        _enCours = false;

        if (resultat is not null)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Annuler() => MudDialog.Cancel();
}
