@inject DomaineApiClient DomaineApi
@inject RegistresApiClient RegistresApi
@inject ISnackbar Snackbar

@*
    Phase 07 — Documents (docs/03-proposition-phases-05-18-v2.md) : recenser les documents que
    l'outil devra produire, recevoir ou archiver. Aucune question bloquante — un projet peut
    légitimement n'avoir aucun document formel à produire.
*@
<MudPaper Class="pa-6" Elevation="2">
    <MudText Typo="Typo.h5" Class="mb-1">Documents</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Quels documents l'outil devra-t-il produire, recevoir ou archiver ?
    </MudText>

    @if (_rappelPhase03.Count > 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <MudText Typo="Typo.body2" Class="mb-1"><b>Outils/fichiers déjà mentionnés en Phase 03 :</b></MudText>
            @foreach (var rappel in _rappelPhase03)
            {
                <MudText Typo="Typo.body2">— @rappel</MudText>
            }
        </MudAlert>
    }

    <MudForm @ref="_form">
        <MudTextField T="string" @bind-Value="_type" Label="Quel est ce document (type) ?"
                       AutoFocus="true" Class="mb-4" Style="min-height:44px" Required="true" />
        <MudTextField T="string" @bind-Value="_origine" Label="D'où vient-il / qui le produit ?" Class="mb-4" Style="min-height:44px" />
        <MudTextField T="string" @bind-Value="_destination" Label="À qui est-il destiné ?" Class="mb-4" Style="min-height:44px" />
        <MudTextField T="string" @bind-Value="_format" Label="Sous quel format ?" Class="mb-4" Style="min-height:44px" />
        <MudTextField T="string" @bind-Value="_dureeConservation" Label="Doit-il être conservé, combien de temps ?" Class="mb-4" Style="min-height:44px" />

        <MudSelect T="SourceInformation" @bind-Value="_source" Label="Source" Class="mb-4">
            <MudSelectItem Value="SourceInformation.Declaratif">Déclaratif (dit par le client)</MudSelectItem>
            <MudSelectItem Value="SourceInformation.Observation">Observation vérifiée</MudSelectItem>
            <MudSelectItem Value="SourceInformation.Document">Document fourni</MudSelectItem>
            <MudSelectItem Value="SourceInformation.SystemeExistant">Système/outil existant</MudSelectItem>
        </MudSelect>
    </MudForm>

    <MudStack Row="true" Spacing="2" Class="mb-6">
        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" FullWidth="true"
                   Disabled="@(_enCours || string.IsNullOrWhiteSpace(_type))"
                   OnClick="@(() => AjouterDocumentAsync(StatutInformation.Valide))" Style="min-height:44px">
            Ajouter — Validé
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Large"
                   Disabled="@(_enCours || string.IsNullOrWhiteSpace(_type))"
                   OnClick="@(() => AjouterDocumentAsync(StatutInformation.AConfirmer))" Style="min-height:44px">
            Ajouter — À confirmer
        </MudButton>
    </MudStack>

    <MudDivider Class="mb-4" />

    <MudText Typo="Typo.subtitle1" Class="mb-2">Documents déjà identifiés (@_documents.Count)</MudText>
    @if (_documents.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Aucun document pour l'instant — c'est normal si ce projet n'en a pas besoin.
        </MudText>
    }
    else
    {
        <MudList T="string">
            @foreach (var document in _documents)
            {
                <MudListItem T="string">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.body1">@document.Type</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(document.Origine is not null ? $"De : {document.Origine}" : "")
                                @(document.Destination is not null ? $" → {document.Destination}" : "")
                            </MudText>
                        </div>
                        @if (document.Statut is StatutInformation.AConfirmer)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">À confirmer</MudChip>
                        }
                        else if (document.Statut is StatutInformation.Valide)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Validé</MudChip>
                        }
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public int ProjetId { get; set; }
    [Parameter, EditorRequired] public int PhaseId { get; set; }

    private MudForm? _form;
    private string _type = string.Empty;
    private string? _origine;
    private string? _destination;
    private string? _format;
    private string? _dureeConservation;
    private SourceInformation _source = SourceInformation.Declaratif;
    private bool _enCours;

    private List<DocumentMetierDto> _documents = [];
    private List<string> _rappelPhase03 = [];

    protected override async Task OnParametersSetAsync()
    {
        await ChargerDocumentsAsync();
        await ChargerRappelAsync();
    }

    private async Task ChargerDocumentsAsync()
    {
        _documents = (await DomaineApi.GetDocumentsAsync(ProjetId)).ToList();
    }

    private async Task ChargerRappelAsync()
    {
        var processus = await DomaineApi.GetProcessusAsync(ProjetId);
        _rappelPhase03 = processus
            .SelectMany(p => p.Etapes)
            .Select(e => e.Outil)
            .Where(o => !string.IsNullOrWhiteSpace(o))
            .Distinct()
            .Select(o => o!)
            .ToList();
    }

    private async Task AjouterDocumentAsync(StatutInformation statut)
    {
        if (_form is null || string.IsNullOrWhiteSpace(_type))
        {
            return;
        }

        _enCours = true;
        var dto = new UpsertDocumentMetierDto(_type, _origine, _destination, _format, _dureeConservation, _source, statut);
        var succes = await DomaineApi.CreerDocumentAsync(ProjetId, dto) is not null;
        _enCours = false;

        if (succes)
        {
            _type = string.Empty;
            _origine = null;
            _destination = null;
            _format = null;
            _dureeConservation = null;
            await ChargerDocumentsAsync();
            Snackbar.Add("Document ajouté.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Impossible d'ajouter le document.", Severity.Error);
        }
    }
}
