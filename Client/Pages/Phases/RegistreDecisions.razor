@inject RegistresApiClient RegistresApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-2">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@OuvrirDialogAsync">
        Ajouter une décision
    </MudButton>
</MudStack>

@if (_decisions is null)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
}
else if (_decisions.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">Aucune décision enregistrée pour ce projet.</MudAlert>
}
else
{
    <MudTable Items="@_decisions" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Code</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Justification</MudTh>
            <MudTh>Alternatives écartées</MudTh>
            <MudTh>Date</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Code">@context.Code</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Justification">@context.Justification</MudTd>
            <MudTd DataLabel="Alternatives écartées">@context.AlternativesEcartees</MudTd>
            <MudTd DataLabel="Date">@context.Date.ToLocalTime().ToString("d")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => SupprimerAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public int ProjetId { get; set; }

    private IReadOnlyList<DecisionRegistreDto>? _decisions;

    protected override async Task OnParametersSetAsync()
    {
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _decisions = await RegistresApi.GetDecisionsAsync(ProjetId);
    }

    private async Task OuvrirDialogAsync()
    {
        var parametres = new DialogParameters<DecisionFormDialog> { { x => x.ProjetId, ProjetId } };
        var dialog = await DialogService.ShowAsync<DecisionFormDialog>("Nouvelle décision", parametres);
        var resultat = await dialog.Result;

        if (resultat is { Canceled: false })
        {
            await ChargerAsync();
        }
    }

    private async Task SupprimerAsync(DecisionRegistreDto decision)
    {
        var succes = await RegistresApi.SupprimerDecisionAsync(ProjetId, decision.Id);
        if (succes)
        {
            Snackbar.Add("Décision supprimée.", Severity.Success);
            await ChargerAsync();
        }
        else
        {
            Snackbar.Add("Suppression impossible.", Severity.Error);
        }
    }
}
