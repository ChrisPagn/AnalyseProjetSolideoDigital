@inject RegistresApiClient RegistresApi

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField T="string" Label="Description de la décision" @bind-Value="_description" Required="true"
                          RequiredError="La description est requise." Lines="2" Class="mb-3" />
            <MudTextField T="string" Label="Justification" @bind-Value="_justification" Lines="2" Class="mb-3" />
            <MudTextField T="string" Label="Alternatives écartées" @bind-Value="_alternativesEcartees" Lines="2" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Annuler">Annuler</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_enCours" OnClick="@EnregistrerAsync">
            @(_enCours ? "Enregistrement..." : "Enregistrer")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int ProjetId { get; set; }

    private MudForm? _form;
    private string _description = string.Empty;
    private string? _justification;
    private string? _alternativesEcartees;
    private bool _enCours;

    private async Task EnregistrerAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _enCours = true;
        var dto = new UpsertDecisionRegistreDto(_description, _justification, _alternativesEcartees);
        var resultat = await RegistresApi.CreerDecisionAsync(ProjetId, dto);
        _enCours = false;

        if (resultat is not null)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Annuler() => MudDialog.Cancel();
}
