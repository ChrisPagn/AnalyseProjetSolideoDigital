@inject IDialogService DialogService

<MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SwapHoriz"
           OnClick="@OuvrirDialogAsync" Style="min-height:44px">
    Transfert prompt maître
</MudButton>

@code {
    [Parameter, EditorRequired] public int ProjetId { get; set; }

    private async Task OuvrirDialogAsync()
    {
        var parametres = new DialogParameters<PromptMaitreDialog> { { x => x.ProjetId, ProjetId } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<PromptMaitreDialog>("Transfert prompt maître", parametres, options);
    }
}
