# Copier ce fichier en .env et renseigner les valeurs réelles sur le serveur.
# Aucune valeur ci-dessous n'est une valeur réelle utilisable en production.

# Provider de base de données : Sqlite (dev/défaut) ou MySql (prod, via Pomelo)
DATABASE_PROVIDER=Sqlite

# Exemple pour MySQL en production :
# CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=mysql-host;Database=analyseprojet;User=analyseprojet;Password=CHANGER_MOI;
